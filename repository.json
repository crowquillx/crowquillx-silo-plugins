      "manifest": {
        "plugin_id": "dev.crowquillx.anilist-sync",
        "version": "0.7.0",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          },
          {
            "os": "darwin",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "watch_sync_provider.v1",
            "id": "anilist",
            "display_name": "AniList",
            "description": "Syncs completed playback and optionally manual watched marks to AniList, and imports mapped watch history.",
            "watch_sync_provider": {
              "auth_methods": [
                3
              ],
              "export_watched": true,
              "import_watched": true,
              "supported_media_types": [
                1,
                2
              ],
              "external_id_namespaces": [
                "anilist",
                "imdb",
                "tmdb",
                "tvdb"
              ],
              "max_batch_size": 25,
              "scrobble_playback": true
            }
          },
          {
            "type": "watch_sync_provider.v1",
            "id": "anilist-silo",
            "display_name": "AniList with Silo watched check",
            "description": "Checks the selected Silo profile for watched state when a player stops at zero. Connect with an AniList token and a Silo API key.",
            "config_schema": [
              {
                "key": "silo",
                "title": "Silo watched verification",
                "description": "Use the same Silo account and profile as this watch-provider connection.",
                "json_schema": "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"base_url\":{\"type\":\"string\",\"format\":\"uri\",\"minLength\":1},\"api_key\":{\"type\":\"string\",\"format\":\"password\",\"minLength\":1},\"profile_id\":{\"type\":\"string\",\"minLength\":1}},\"required\":[\"base_url\",\"api_key\",\"profile_id\"]}",
                "required": true,
                "admin_form": {
                  "fields": [
                    {
                      "key": "base_url",
                      "label": "Silo server URL",
                      "description": "The native Silo server URL reachable from the plugin, for example https://silo.example.com. Use HTTPS for remote servers.",
                      "control": 1,
                      "required": true
                    },
                    {
                      "key": "api_key",
                      "label": "Silo API key",
                      "description": "An API key for the Silo account that owns this profile. Stored with this connection.",
                      "control": 3,
                      "required": true,
                      "secret": true
                    },
                    {
                      "key": "profile_id",
                      "label": "Silo profile ID",
                      "description": "The ID of the profile you are connecting. Copy its id from GET /api/v1/profiles.",
                      "control": 1,
                      "required": true
                    }
                  ],
                  "submit_label": "Connect AniList"
                }
              }
            ],
            "watch_sync_provider": {
              "auth_methods": [
                2
              ],
              "export_watched": true,
              "import_watched": true,
              "supported_media_types": [
                1,
                2
              ],
              "external_id_namespaces": [
                "anilist",
                "imdb",
                "tmdb",
                "tvdb"
              ],
              "max_batch_size": 25,
              "scrobble_playback": true
            }
          }
        ],
        "global_config_schema": [
          {
            "key": "provider",
            "title": "AniList provider settings",
            "description": "Watched synchronization behavior.",
            "json_schema": "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"sync_manual_watched\":{\"type\":\"boolean\",\"default\":false},\"playback_completion_percent\":{\"type\":\"number\",\"minimum\":1,\"maximum\":99,\"default\":90},\"import_full_scan\":{\"type\":\"boolean\",\"default\":false},\"only_existing_entries\":{\"type\":\"boolean\",\"default\":false}}}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "sync_manual_watched",
                  "label": "Sync manually marked watched items",
                  "description": "Also send items marked watched without being played. The existing-entry restriction applies to both playback and manual marks when enabled.",
                  "control": 5,
                  "default_value": false
                },
                {
                  "key": "playback_completion_percent",
                  "label": "Playback completion threshold",
                  "description": "Playback must pass this percentage before AniList progress advances. Match Silo's watched threshold.",
                  "control": 4,
                  "required": true,
                  "default_value": 90,
                  "validation": {
                    "has_min": true,
                    "min": 1,
                    "has_max": true,
                    "max": 99
                  }
                },
                {
                  "key": "import_full_scan",
                  "label": "Full import scan",
                  "description": "Rescan the complete AniList list on the next sync instead of only entries changed since the last scan. Turn off again afterwards to resume fast incremental syncs.",
                  "control": 5,
                  "default_value": false
                },
                {
                  "key": "only_existing_entries",
                  "label": "Only update anime already on AniList",
                  "description": "Skip exports for anime absent from the connected account's list. Add titles to Plan to Watch before watching. Reduces unwanted additions from false matches; does not filter Silo libraries or watched-history imports.",
                  "control": 5,
                  "default_value": false
                }
              ],
              "submit_label": "Save AniList settings"
            }
          }
        ],
        "category": "Integrations/Tracking",
        "presentation": {
          "display_name": "AniList Sync",
          "summary": "Reliably synchronize completed anime with AniList through Silo's watch-provider pipeline.",
          "description_markdown": "Uses Silo's host-owned watch-sync pipeline for encrypted per-profile credentials, durable playback completion delivery, optional manual watched marks, retries, imports, and rich episode identity. Episode exports prefer the daily AniBridge v3 dataset, with an Anime-Lists and ARM fallback. Watch-history imports reverse-map AniList progress through AniBridge. AniList progress is monotonic and ambiguous mappings are rejected rather than guessed.",
          "setup_markdown": "Install the plugin and match the playback completion threshold to Silo's watched threshold. To connect a profile, open Settings \u2192 Watch Providers \u2192 AniList and select Connect. Silo shows a code and a button that opens the activation page; enter the code, approve access on AniList, and return to Silo \u2014 the connection completes automatically and shows your account. AniList tokens last about one year; reconnect when the credential expires. A manual paste flow remains documented in the plugin README as a fallback. For Neptune or Jellycompat players that report a stop at zero, connect the optional AniList with Silo watched check provider using an AniList access token, your Silo server URL, a Silo API key, and the current Silo profile ID. This connection checks saved watched state for that exact item and profile. See the README for setup; disconnect the ordinary AniList provider for that profile to avoid duplicate synchronization.",
          "homepage_url": "https://github.com/crowquillx/silo-anilist-sync",
          "source_url": "https://github.com/crowquillx/silo-anilist-sync",
          "support_url": "https://github.com/crowquillx/silo-anilist-sync/issues",
          "changelog_url": "https://github.com/crowquillx/silo-anilist-sync/releases",
          "publisher_name": "crowquillx",
          "publisher_url": "https://github.com/crowquillx",
          "license_spdx": "MIT"
        }
      },
      "repo_url": "https://github.com/crowquillx/silo-anilist-sync",
