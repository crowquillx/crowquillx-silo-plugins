          "url": "https://github.com/crowquillx/silo-anilist-sync/releases/download/v0.8.0/plugin-darwin-arm64",
          "checksum": "8ced849772209d159e0b7a57a5593c5b67620dd6a31529a5d6ed24e8c78f0430"
        }
