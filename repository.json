          "checksum": "36f3a73a28db14d574878d434d0434093641b717f5f522bcb3845de527a7623d"
        },
        "darwin/arm64": {
          "url": "https://github.com/crowquillx/silo-light-novel-metadata/releases/download/v0.1.0/plugin-darwin-arm64",
