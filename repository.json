          },
          {
            "id": "setup",
            "method": "GET",
            "path": "/v1/setup",
            "access": "authenticated",
            "navigable": true,
            "navigation_label": "Comic Pages",
            "navigation_kind": "user"
          }
        ],
        "presentation": {
          "display_name": "Comic Pages (Deprecated)",
          "summary": "Deprecated: This plugin is no longer maintained and may not work with current Silo releases. It will be removed from this catalog.",
          "description_markdown": "**Deprecated.** This plugin is no longer maintained and may not work with current Silo releases. It will be removed from this catalog.\n\nExtracts comic pages from RAR4, RAR5 and ZIP archives using the reader's existing Silo access. Supports solid RAR archives, natural page ordering and a bounded extraction cache. Linux amd64 and arm64. No media filesystem mapping or proprietary unrar executable is required.",
          "setup_markdown": "Configure the Silo base URL reachable from the plugin and a dedicated writable cache directory. The Aidoku Silo source v11 or newer finds this installation automatically; older sources need its installation ID in Reading \u2192 Comic Pages plugin installation ID. See the README for resource limits.",
          "homepage_url": "https://github.com/crowquillx/silo-comic-pages",
          "source_url": "https://github.com/crowquillx/silo-comic-pages",
          "support_url": "https://github.com/crowquillx/silo-comic-pages/issues",
          "changelog_url": "https://github.com/crowquillx/silo-comic-pages/releases",
          "publisher_name": "crowquillx",
          "publisher_url": "https://github.com/crowquillx",
          "license_spdx": "MIT"
        }
      },
      "repo_url": "https://github.com/crowquillx/silo-comic-pages"
    },
    {
      "manifest": {
        "plugin_id": "dev.crowquillx.light-novel-metadata",
        "version": "0.1.0",
        "checksum": "e4b840d0df93d191cc87e0e47a58fd154c82303afce5c8b1f5befa914f308f08",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          },
          {
            "os": "darwin",
            "arch": "arm64"
          }
        ],
        "presentation": {
          "display_name": "Light Novel Metadata (Deprecated)",
          "summary": "Deprecated: This plugin is no longer maintained and may not work with current Silo releases. It will be removed from this catalog.",
          "description_markdown": "**Deprecated.** This plugin is no longer maintained and may not work with current Silo releases. It will be removed from this catalog.\n\nMatches each light novel volume to [RanobeDB](https://ranobedb.org), a light novel database, by ISBN or title. Adds English and Japanese titles, descriptions, release dates, publishers, authors, genres, and series order. Covers come from Amazon, J-Novel Club, or Open Library when a high-resolution copy exists, falling back to RanobeDB. Series banners come from AniList and J-Novel Club.",
          "setup_markdown": "Open the ebook library that holds your light novels, add **Light Novel Metadata** to its metadata providers, and move it above **Ebook Metadata**. The plugin is not enabled for ebook libraries automatically, so general ebook libraries are unaffected. Titles and descriptions follow each book's language unless **Preferred language** is set.",
          "homepage_url": "https://github.com/crowquillx/silo-light-novel-metadata",
          "source_url": "https://github.com/crowquillx/silo-light-novel-metadata",
          "support_url": "https://github.com/crowquillx/silo-light-novel-metadata/issues",
          "changelog_url": "https://github.com/crowquillx/silo-light-novel-metadata/releases",
          "publisher_name": "crowquillx",
          "publisher_url": "https://github.com/crowquillx",
          "license_spdx": "MIT"
        },
        "capabilities": [
          {
            "type": "metadata_provider.v1",
            "id": "light-novel-metadata",
            "display_name": "Light Novel Metadata",
            "description": "Light novel volume metadata from RanobeDB, with high-resolution covers from Amazon, J-Novel Club, and Open Library, and series banners from AniList.",
            "metadata": {
              "default_priority": {
                "ebook": 1
              },
              "default_enabled": false,
              "lookup_provider_ids": [
                "isbn"
              ]
            }
          }
        ],
        "global_config_schema": [
          {
            "key": "preferred_language",
            "title": "Preferred language",
            "description": "Language code for titles, descriptions, and covers, such as en or ja. Empty follows each book's language and falls back to English.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"string\"}}}",
            "admin_form": {
              "fields": [
                {
                  "key": "value",
                  "label": "Language code",
                  "control": 1
                }
              ]
            }
          },
          {
            "key": "cover_sources",
            "title": "Cover sources",
            "description": "Comma-separated cover sources in order of preference: amazon, jnovelclub, openlibrary, ranobedb. Empty uses that order. Remove a source to stop requesting covers from it.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"string\"}}}",
            "admin_form": {
              "fields": [
                {
                  "key": "value",
                  "label": "Sources",
                  "control": 1
                }
              ]
            }
          },
          {
            "key": "enable_banners",
            "title": "Series banners",
            "description": "Use AniList or J-Novel Club series banners as backdrops.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"boolean\"}}}",
            "admin_form": {
              "fields": [
                {
                  "key": "value",
                  "label": "Add banners",
                  "control": 5,
                  "default_value": true
                }
              ]
            }
          },
          {
            "key": "native_name_order",
            "title": "Japanese name order",
            "description": "Credit Japanese authors family name first, as RanobeDB lists them (Kawahara Reki). Off uses the given-name-first order of English editions (Reki Kawahara).",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"boolean\"}}}",
            "admin_form": {
              "fields": [
                {
                  "key": "value",
                  "label": "Family name first",
                  "control": 5,
                  "default_value": false
                }
              ]
            }
          }
        ]
      },
