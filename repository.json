      "binaries": {
        "linux/amd64": {
          "checksum": "b9c704ada7030e7dcde6ffd3c84e44746c98325859406f6099d4f45935c547c8",
          "url": "https://github.com/crowquillx/silo-comic-pages/releases/download/v0.2.0/plugin-linux-amd64"
