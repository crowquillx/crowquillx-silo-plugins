                {
                  "key": "profile_id",
                  "label": "Profile ID",
                  "control": 1,
                  "placeholder": "The API key owner's primary profile"
                },
                {
                  "key": "state_dir",
                  "label": "Persistent state directory",
                  "description": "Needed only when Silo installs plugins outside its plugin directory.",
                  "control": 1,
                  "placeholder": "plugin-state in Silo's plugin directory"
                },
                {
                  "key": "ffprobe",
                  "label": "ffprobe path",
                  "control": 1,
