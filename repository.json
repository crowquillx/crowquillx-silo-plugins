                      "equals": [
                        "true"
                      ]
                    }
                  ]
                },
                {
                  "key": "anime_endings",
                  "label": "Anime endings",
                  "control": 5,
                  "default_value": true,
                  "show_when": [
                    {
                      "field": "anime_themes",
                      "equals": [
                        "true"
                      ]
                    }
                  ]
                },
                {
                  "key": "anime_spoilers",
                  "label": "Allow anime themes marked as spoilers",
                  "control": 5,
                  "default_value": false,
                  "show_when": [
                    {
                      "field": "anime_themes",
                      "equals": [
                        "true"
                      ]
                    }
                  ]
                },
                {
                  "key": "anime_nsfw",
                  "label": "Allow anime themes marked as NSFW",
                  "control": 5,
                  "default_value": false,
                  "show_when": [
                    {
                      "field": "anime_themes",
                      "equals": [
                        "true"
                      ]
                    }
                  ]
                },
                {
                  "key": "assisted_search",
                  "label": "Suggest YouTube matches",
                  "description": "When ThemerrDB has no theme for an item, search YouTube and list candidates on the Theme Songs page. Nothing is downloaded until you save a URL for the item.",
                  "control": 5,
                  "default_value": false
                },
                {
                  "key": "anime_library_ids",
                  "label": "AnimeThemes libraries",
                  "description": "Library IDs separated by commas. Leave empty to check every series library for anime.",
                  "control": 1,
                  "placeholder": "All series libraries"
                },
                {
                  "key": "exclude_items",
                  "label": "Skip these items",
                  "description": "Catalog item IDs separated by commas.",
                  "control": 2,
                  "placeholder": "None"
                },
                {
                  "key": "max_downloads",
                  "label": "Downloads per run",
                  "description": "0 means no limit.",
                  "control": 4,
                  "default_value": 0,
                  "validation": {
                    "has_min": true,
                    "min": 0,
                    "has_max": true,
                    "max": 10000
                  }
                },
                {
                  "key": "manage_tools",
