{
  "plugins": [
    {
      "manifest": {
        "plugin_id": "dev.crowquillx.anilist-sync",
        "version": "0.6.0",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          },
          {
            "os": "darwin",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "watch_sync_provider.v1",
            "id": "anilist",
            "display_name": "AniList",
            "description": "Syncs completed playback and optionally manual watched marks to AniList, and imports mapped watch history.",
            "watch_sync_provider": {
              "auth_methods": [
                3
              ],
              "export_watched": true,
              "import_watched": true,
              "supported_media_types": [
                1,
                2
              ],
              "external_id_namespaces": [
                "anilist",
                "imdb",
                "tmdb",
                "tvdb"
              ],
              "max_batch_size": 25,
              "scrobble_playback": true
            }
          }
        ],
        "global_config_schema": [
          {
            "key": "provider",
            "title": "AniList provider settings",
            "description": "Watched synchronization behavior.",
            "json_schema": "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"sync_manual_watched\":{\"type\":\"boolean\",\"default\":false},\"playback_completion_percent\":{\"type\":\"number\",\"minimum\":1,\"maximum\":99,\"default\":90},\"import_full_scan\":{\"type\":\"boolean\",\"default\":false}}}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "sync_manual_watched",
                  "label": "Sync manually marked watched items",
                  "description": "Also send items marked watched without being played. Completed playback always syncs.",
                  "control": 5,
                  "default_value": false
                },
                {
                  "key": "playback_completion_percent",
                  "label": "Playback completion threshold",
                  "description": "Playback must pass this percentage before AniList progress advances. Match Silo's watched threshold.",
                  "control": 4,
                  "required": true,
                  "default_value": 90,
                  "validation": {
                    "has_min": true,
                    "min": 1,
                    "has_max": true,
                    "max": 99
                  }
                },
                {
                  "key": "import_full_scan",
                  "label": "Full import scan",
                  "description": "Rescan the complete AniList list on the next sync instead of only entries changed since the last scan. Turn off again afterwards to resume fast incremental syncs.",
                  "control": 5,
                  "default_value": false
                }
              ],
              "submit_label": "Save AniList settings"
            }
          }
        ],
        "category": "Integrations/Tracking",
        "presentation": {
          "display_name": "AniList Sync",
          "summary": "Reliably synchronize completed anime with AniList through Silo's watch-provider pipeline.",
          "description_markdown": "Uses Silo's host-owned watch-sync pipeline for encrypted per-profile credentials, durable playback completion delivery, optional manual watched marks, retries, imports, and rich episode identity. Episode exports prefer the daily AniBridge v3 dataset, with an Anime-Lists and ARM fallback. Watch-history imports reverse-map AniList progress through AniBridge. AniList progress is monotonic and ambiguous mappings are rejected rather than guessed.",
          "setup_markdown": "Install the plugin and match the playback completion threshold to Silo's watched threshold. To connect a profile, open Settings \u2192 Watch Providers \u2192 AniList and select Connect. Silo shows a code and a button that opens the activation page; enter the code, approve access on AniList, and return to Silo \u2014 the connection completes automatically and shows your account. AniList tokens last about one year; reconnect when the credential expires. A manual paste flow remains documented in the plugin README as a fallback.",
          "homepage_url": "https://github.com/crowquillx/silo-anilist-sync",
          "source_url": "https://github.com/crowquillx/silo-anilist-sync",
          "support_url": "https://github.com/crowquillx/silo-anilist-sync/issues",
          "changelog_url": "https://github.com/crowquillx/silo-anilist-sync/releases",
          "publisher_name": "crowquillx",
          "publisher_url": "https://github.com/crowquillx",
          "license_spdx": "MIT"
        }
      },
      "repo_url": "https://github.com/crowquillx/silo-anilist-sync",
      "binaries": {
        "linux/amd64": {
          "url": "https://github.com/crowquillx/silo-anilist-sync/releases/download/v0.6.0/plugin-linux-amd64",
          "checksum": "be2f82ff9c83fe534ae19092425dc2a0dff6a44a394cd7403af279fb96d3b3e7"
        },
        "linux/arm64": {
          "url": "https://github.com/crowquillx/silo-anilist-sync/releases/download/v0.6.0/plugin-linux-arm64",
          "checksum": "6bba4ca86665b0a1af4cb963e6fff11a4d3b40e51d435824f3b0edb0d29febf2"
        },
        "darwin/arm64": {
          "url": "https://github.com/crowquillx/silo-anilist-sync/releases/download/v0.6.0/plugin-darwin-arm64",
          "checksum": "3149f228973b41795f6a23c7eaa171c1b51b098dd889cba00e9bdf662d666a03"
        }
      }
    },
    {
      "binaries": {
        "linux/amd64": {
          "checksum": "59293bd07e7a163359ffc64feb2040646b5901195738165e099a0fc69818da60",
          "url": "https://github.com/crowquillx/silo-comic-pages/releases/download/v0.1.1/plugin-linux-amd64"
        },
        "linux/arm64": {
          "checksum": "f0f610354bf660db79da5c27fe14d3eb43c035f5d644ea215b0663b442094f60",
          "url": "https://github.com/crowquillx/silo-comic-pages/releases/download/v0.1.1/plugin-linux-arm64"
        }
      },
      "manifest": {
        "plugin_id": "dev.crowquillx.comic-pages",
        "version": "0.1.1",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "http_routes.v1",
            "id": "comic-pages",
            "display_name": "Comic Pages",
            "description": "Extracts pages from authenticated Silo comic archives."
          }
        ],
        "global_config_schema": [
          {
            "key": "connection",
            "title": "Silo connection",
            "description": "The Silo origin and a private cache directory.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"base_url\":{\"type\":\"string\",\"minLength\":1},\"cache_dir\":{\"type\":\"string\",\"minLength\":1},\"max_cache_bytes\":{\"type\":\"integer\",\"minimum\":1},\"max_entries\":{\"type\":\"integer\",\"minimum\":1},\"max_page_bytes\":{\"type\":\"integer\",\"minimum\":1},\"max_total_bytes\":{\"type\":\"integer\",\"minimum\":1},\"max_archive_bytes\":{\"type\":\"integer\",\"minimum\":1},\"max_dictionary_bytes\":{\"type\":\"integer\",\"minimum\":1}},\"required\":[\"base_url\",\"cache_dir\"],\"additionalProperties\":false}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "base_url",
                  "label": "Silo base URL",
                  "control": 1,
                  "placeholder": "https://silo.example",
                  "required": true
                },
                {
                  "key": "cache_dir",
                  "label": "Private cache directory",
                  "control": 1,
                  "placeholder": "/var/lib/silo/comic-pages-cache",
                  "required": true
                },
                {
                  "key": "max_cache_bytes",
                  "label": "Maximum cache bytes",
                  "control": 4,
                  "placeholder": "2147483648"
                },
                {
                  "key": "max_entries",
                  "label": "Maximum archive entries",
                  "control": 4,
                  "placeholder": "2048"
                },
                {
                  "key": "max_page_bytes",
                  "label": "Maximum page bytes",
                  "control": 4,
                  "placeholder": "33554432"
                },
                {
                  "key": "max_total_bytes",
                  "label": "Maximum extracted bytes",
                  "control": 4,
                  "placeholder": "1073741824"
                },
                {
                  "key": "max_archive_bytes",
                  "label": "Maximum archive bytes",
                  "control": 4,
                  "placeholder": "536870912"
                },
                {
                  "key": "max_dictionary_bytes",
                  "label": "Maximum RAR dictionary bytes",
                  "control": 4,
                  "placeholder": "67108864"
                }
              ]
            }
          }
        ],
        "http_routes": [
          {
            "id": "health",
            "method": "GET",
            "path": "/v1/health",
            "access": "authenticated"
          },
          {
            "id": "pages",
            "method": "POST",
            "path": "/v1/pages",
            "access": "authenticated"
          },
          {
            "id": "page",
            "method": "POST",
            "path": "/v1/page/*",
            "access": "authenticated"
          }
        ],
        "presentation": {
          "display_name": "Comic Pages",
          "summary": "Read CBR/RAR comics in Aidoku using server-side page extraction.",
          "description_markdown": "Extracts comic pages from RAR4, RAR5 and ZIP archives using the reader's existing Silo access. Supports solid RAR archives, natural page ordering and a bounded extraction cache. Linux amd64 and arm64. No media filesystem mapping or proprietary unrar executable is required.",
          "setup_markdown": "Configure the Silo base URL reachable from the plugin and a dedicated writable cache directory. Update the Aidoku Silo source to v5 or newer, then enter this installation's ID in Reading \u2192 Comic Pages plugin installation ID. See the README for resource limits.",
          "homepage_url": "https://github.com/crowquillx/silo-comic-pages",
          "source_url": "https://github.com/crowquillx/silo-comic-pages",
          "support_url": "https://github.com/crowquillx/silo-comic-pages/issues",
          "changelog_url": "https://github.com/crowquillx/silo-comic-pages/releases",
          "publisher_name": "crowquillx",
          "publisher_url": "https://github.com/crowquillx",
          "license_spdx": "MIT"
        }
      },
      "repo_url": "https://github.com/crowquillx/silo-comic-pages"
    },
    {
      "manifest": {
        "plugin_id": "silo.shokoanime",
        "version": "0.1.2",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          },
          {
            "os": "darwin",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "metadata_provider.v1",
            "id": "shoko",
            "display_name": "Shoko",
            "description": "Exact Shoko series and episode metadata for VFS paths.",
            "metadata": {
              "default_priority": {
                "episode": 1,
                "movie": 1,
                "season": 1,
                "series": 1
              }
            }
          },
          {
            "type": "image_resolver.v1",
            "id": "shoko",
            "display_name": "Shoko Images",
            "description": "Resolves opaque shoko://image/ paths to Shoko image URLs.",
            "metadata": {
              "priority": 100,
              "schemes": [
                "shoko"
              ]
            }
          },
          {
            "type": "scheduled_task.v1",
            "id": "reconcile",
            "display_name": "Reconcile Shoko VFS",
            "description": "Plans and reconciles plugin-owned Shoko VFS links."
          },
          {
            "type": "scan_source.v1",
            "id": "shoko",
            "display_name": "Shoko VFS changes",
            "description": "Reports successfully reconciled VFS paths so Silo can scan them automatically."
          }
        ],
        "global_config_schema": [
          {
            "key": "connection",
            "title": "ShokoAnime connection",
            "description": "Shoko connection and VFS path policy. The API key is encrypted by Silo.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"base_url\":{\"type\":\"string\",\"format\":\"uri\",\"minLength\":1},\"api_key\":{\"type\":\"string\",\"minLength\":1},\"vfs_root\":{\"type\":\"string\",\"minLength\":1},\"managed_folder_map\":{\"type\":\"string\",\"minLength\":2}},\"required\":[\"base_url\",\"api_key\",\"vfs_root\",\"managed_folder_map\"],\"additionalProperties\":false}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "base_url",
                  "label": "Shoko Server URL",
                  "control": 1,
                  "placeholder": "http://shoko:8111",
                  "required": true
                },
                {
                  "key": "api_key",
                  "label": "API key",
                  "control": 3,
                  "required": true,
                  "secret": true
                },
                {
                  "key": "vfs_root",
                  "label": "VFS output root",
                  "control": 1,
                  "placeholder": "/srv/silo/shoko-vfs",
                  "required": true
                },
                {
                  "key": "managed_folder_map",
                  "label": "Managed-folder path map (JSON)",
                  "control": 2,
                  "placeholder": "{\"1\": \"/media/anime\"}",
                  "required": true,
                  "multiline": true,
                  "rows": 5
                }
              ]
            }
          }
        ],
        "presentation": {
          "display_name": "ShokoAnime VFS",
          "summary": "Builds a Shoko-backed virtual filesystem for Silo libraries.",
          "description_markdown": "Reads Shoko Server API v3, reconciles deterministic plugin-owned leaf symlinks, and publishes successful VFS changes for targeted Silo scans. It deliberately does not expose remote streams or modify Shoko data.",
          "setup_markdown": "Configure a Shoko Server URL, API key, a Silo-visible output root, and managed-folder path mappings. Start with a dry-run reconcile and verify that the plugin and Silo share the same filesystem namespace. Enable the Shoko VFS autoscan source: the scheduled task uses a bounded step and scan_source.v1 resumes pending work and queues targeted scans after successful commits.",
          "homepage_url": "https://github.com/crowquillx/silo-shoko-plugin",
          "source_url": "https://github.com/crowquillx/silo-shoko-plugin",
          "support_url": "https://github.com/crowquillx/silo-shoko-plugin/issues",
          "changelog_url": "https://github.com/crowquillx/silo-shoko-plugin/releases",
          "publisher_name": "Renkei",
          "publisher_url": "https://github.com/crowquillx",
          "license_spdx": "MIT"
        }
      },
      "repo_url": "https://github.com/crowquillx/silo-shoko-plugin",
      "binaries": {
        "linux/amd64": {
          "url": "https://github.com/crowquillx/silo-shoko-plugin/releases/download/v0.1.2/plugin-linux-amd64",
          "checksum": "35fef409cf91557878a4814b85e53ab385997b795b1a167423fa33d4f0f39cde"
        },
        "linux/arm64": {
          "url": "https://github.com/crowquillx/silo-shoko-plugin/releases/download/v0.1.2/plugin-linux-arm64",
          "checksum": "4228ed940098cf0015350a5fe4ddb71e40685899f35b22738dd68bff33d64a2d"
        },
        "darwin/arm64": {
          "url": "https://github.com/crowquillx/silo-shoko-plugin/releases/download/v0.1.2/plugin-darwin-arm64",
          "checksum": "b9d93473944aaae9a550435ceeb61e57ffbdcd66a43664c3114ebeda1cde83cc"
        }
      }
    }
  ]
}
