      "manifest": {
        "plugin_id": "silo.shokoanime",
        "version": "0.2.0",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          },
          {
            "os": "darwin",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "metadata_provider.v1",
            "id": "shoko",
            "display_name": "Shoko",
            "description": "Exact Shoko series and episode metadata for VFS paths.",
            "metadata": {
              "default_priority": {
                "episode": 1,
                "movie": 1,
                "season": 1,
                "series": 1
              },
              "rating_sources": [
                {
                  "id": "anidb",
                  "name": "AniDB",
                  "scale": 10
                }
              ]
            }
          },
          {
            "type": "image_resolver.v1",
            "id": "shoko",
            "display_name": "Shoko Images",
            "description": "Resolves opaque shoko://image/ paths to Shoko image URLs.",
            "metadata": {
              "priority": 100,
              "schemes": [
                "shoko"
              ]
            }
          },
          {
            "type": "scheduled_task.v1",
            "id": "reconcile",
            "display_name": "Reconcile Shoko VFS",
            "description": "Plans and reconciles plugin-owned Shoko VFS links."
          },
          {
            "type": "scan_source.v1",
            "id": "shoko",
            "display_name": "Shoko VFS changes",
            "description": "Reports successfully reconciled VFS paths so Silo can scan them automatically."
          }
        ],
        "global_config_schema": [
          {
            "key": "connection",
            "title": "ShokoAnime connection",
            "description": "Shoko connection and VFS path policy. The API key is encrypted by Silo.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"base_url\":{\"type\":\"string\",\"format\":\"uri\",\"minLength\":1},\"api_key\":{\"type\":\"string\",\"minLength\":1},\"vfs_root\":{\"type\":\"string\",\"minLength\":1},\"managed_folder_map\":{\"type\":\"string\",\"minLength\":2}},\"required\":[\"base_url\",\"api_key\",\"vfs_root\",\"managed_folder_map\"],\"additionalProperties\":false}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "base_url",
                  "label": "Shoko Server URL",
                  "control": 1,
                  "placeholder": "http://shoko:8111",
                  "required": true
                },
                {
                  "key": "api_key",
                  "label": "API key",
                  "control": 3,
                  "required": true,
                  "secret": true
                },
                {
                  "key": "vfs_root",
                  "label": "VFS output root",
                  "control": 1,
                  "placeholder": "/srv/silo/shoko-vfs",
                  "required": true
                },
                {
                  "key": "managed_folder_map",
                  "label": "Managed-folder path map (JSON)",
                  "control": 2,
                  "placeholder": "{\"1\": \"/media/anime\"}",
                  "required": true,
                  "multiline": true,
                  "rows": 5
                }
              ]
            }
          }
        ],
        "presentation": {
          "display_name": "ShokoAnime VFS",
          "summary": "Builds a Shoko-backed virtual filesystem for Silo libraries.",
          "description_markdown": "Works with both stable (5.x) and daily (6.x) Shoko Server. Reads Shoko Server API v3, reconciles deterministic plugin-owned leaf symlinks, and publishes successful VFS changes for targeted Silo scans. It deliberately does not expose remote streams or modify Shoko data.",
          "setup_markdown": "Configure a Shoko Server URL, API key, a Silo-visible output root, and managed-folder path mappings, then use the connection test: it checks the URL, the API key, and every mapped folder. The plugin and Silo must share the same filesystem namespace. Run the Reconcile Shoko VFS task to build the library: a crawl that outlasts the task keeps running in the background, and the task output reports its progress. Enable the Shoko VFS autoscan source so Silo scans changed paths automatically.",
          "homepage_url": "https://github.com/crowquillx/silo-shoko-plugin",
          "source_url": "https://github.com/crowquillx/silo-shoko-plugin",
          "support_url": "https://github.com/crowquillx/silo-shoko-plugin/issues",
          "changelog_url": "https://github.com/crowquillx/silo-shoko-plugin/releases",
          "publisher_name": "Renkei",
          "publisher_url": "https://github.com/crowquillx",
          "license_spdx": "MIT"
        }
