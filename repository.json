          "url": "https://github.com/crowquillx/silo-comic-pages/releases/download/v0.2.0/plugin-linux-arm64"
        }
      },
      "manifest": {
        "plugin_id": "dev.crowquillx.comic-pages",
        "version": "0.2.0",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
